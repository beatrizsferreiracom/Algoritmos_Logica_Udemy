Algoritmo "Exercício - Fatorial"

Var

   n, i, fatorial : inteiro


Inicio

      escreva("Digite o valor de N: ")
      leia(n)
      escreval
      
      fatorial <- 1
      
      para i de 1 ate n faca
         fatorial <- fatorial * i
      fimpara
      
      escreval("Fatorial = ", fatorial)


Fimalgoritmo