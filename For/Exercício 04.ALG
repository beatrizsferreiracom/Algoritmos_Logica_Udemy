Algoritmo "Exercício - Tabuada"

Var

   i, numero, multi : inteiro

Inicio

      escreva ("Deseja a tabuada para qual valor? ")
      leia (numero)
      escreval
      
      escreval("Tabuada:")
      
      para i de 1 ate 10 faca
      
      multi <- i * numero
      
      escreval(numero, " x ", i, " = ", multi)
      
      fimpara
      
Fimalgoritmo